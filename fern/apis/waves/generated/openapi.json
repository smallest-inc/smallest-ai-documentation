      "TtsRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Text to synthesize."
          },
          "voice_id": {
            "type": "string",
            "description": "Voice catalog ID or completed clone ID."
          },
          "model": {
            "type": "string",
            "enum": [
              "lightning_v3.1",
              "lightning_v3.1_pro",
              "lightning_v3.1_pro_07_26"
            ],
            "default": "lightning_v3.1",
            "description": "Lightning model pool. Omit for standard Lightning v3.1."
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2,
            "default": 1,
            "description": "Speaking-speed multiplier."
          },
          "sample_rate": {
            "type": "number",
            "default": 44100,
            "description": "Output sample rate in Hz: 8000, 16000, 24000, or 44100.",
            "enum": [
              8000,
              16000,
              24000,
              44100
            ]
          },
          "save_history": {
            "type": "boolean",
            "default": false,
            "description": "Save this synthesis in history."
          },
          "language": {
            "type": "string",
            "default": "auto",
            "description": "Synthesis language or auto detection.",
            "enum": [
              "en",
              "hi",
              "mr",
              "kn",
              "ta",
              "bn",
              "gu",
              "de",
              "fr",
              "es",
              "it",
              "pl",
              "nl",
              "ru",
              "ar",
              "he",
              "sv",
              "ml",
              "te",
              "pt",
              "pa",
              "or",
              "auto",
              "el",
              "fi",
              "no",
              "zh",
              "id",
              "ja",
              "ko",
              "ms",
              "tr",
              "vi"
            ]
          },
          "number_pronunciation_language": {
            "type": "string",
            "description": "Optional language used to normalize numbers independently of synthesis."
          },
          "math_notation": {
            "type": "boolean",
            "default": false,
            "description": "Read digit-flanked mathematical operators as words."
          },
          "output_format": {
            "type": "string",
            "enum": [
              "wav",
              "ulaw",
              "alaw",
              "pcm",
              "mp3"
            ],
            "default": "pcm",
            "description": "Audio encoding for each returned chunk."
          },
          "add_wav_header": {
            "type": "boolean",
            "default": false,
            "description": "Prepend a WAV header when returning compatible audio."
          },
          "pronunciation_dicts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            },
            "description": "Pronunciation dictionary IDs to apply."
          },
          "enhancement": {
            "type": [
              "number",
              "null"
            ],
            "description": "Quality enhancement level: 0, 1, or 2.",
            "enum": [
              0,
              1,
              2
            ]
          },
          "similarity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "Voice similarity control from 0 to 1."
          },
          "word_timestamps": {
            "type": "boolean",
            "default": false,
            "description": "Emit word_timestamp response frames when supported."
          }
        },
        "required": [
          "text",
          "voice_id"
        ]
      },
      "TtsHttpError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
