              "error"
            ]
          },
          "error_code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "authentication_required",
              "unauthenticated",
              "organization_required",
              "rate_limit_exceeded",
              "service_unavailable",
              "upstream_error",
              "upstream_overloaded",
