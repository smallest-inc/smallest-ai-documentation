    "schemas": {
      "PiiTextRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "description": "Text to inspect and redact."
          },
          "replacement_format": {
            "type": "string",
            "enum": [
              "tag",
              "asterisk"
            ],
            "default": "tag",
            "description": "Replace entities with typed tags or same-length asterisks."
          }
        },
        "required": [
          "text"
        ]
      },
      "PiiTextResponse": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "redacted_text": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Detected PII category."
                },
                "original_text": {
                  "type": "string",
                  "description": "Detected text before replacement."
                },
                "replacement": {
                  "type": "string",
                  "description": "Text substituted into the redacted output."
                },
                "score": {
                  "type": "number",
                  "description": "Detection confidence score."
                },
                "position": {}
              },
              "required": [
                "type",
                "original_text",
                "replacement",
                "score"
              ]
            }
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "model",
          "redacted_text",
          "entities",
          "request_id"
        ]
      },
      "PiiAudioRequest": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "beep",
              "silence",
              "noise"
            ],
            "default": "beep",
            "description": "Audio replacement applied to detected PII spans."
          },
          "audio": {
            "type": "string",
            "format": "binary"
          }
        },
        "required": [
          "audio"
        ]
      },
      "PiiAudioResponse": {
        "type": "object",
        "properties": {
          "audio_base64": {
            "type": "string",
            "description": "Base64-encoded redacted WAV audio."
          },
          "redaction_method": {
            "type": "string",
            "enum": [
              "beep",
              "silence",
              "noise"
            ]
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "audio_base64",
          "redaction_method",
          "request_id"
        ]
      },
